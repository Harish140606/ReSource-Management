# Database — PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret

# Server
NODE_ENV=development
PORT=4000

# CORS — the client origin (Vite dev server by default)
CLIENT_ORIGIN=http://localhost:5173

# Email notifications (Brevo HTTP API — free 300/day, no domain needed)
# 1. Sign up at brevo.com with your Gmail
# 2. Settings → Senders → Add your Gmail → verify the confirmation email
# 3. Settings → API Keys → create a key → paste below
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_EMAIL=yourname@gmail.com
FRONTEND_URL=http://localhost:5173
